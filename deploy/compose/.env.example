# Copy to .env and fill in. Never commit .env.

# ---- secrets -----------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Keyed hash for pseudonymised columns; a long random string (e.g. `openssl rand -hex 32`).
ALC_PSEUDONYM_KEY=change-me-as-well

# ---- image -------------------------------------------------------------------
# ALC_IMAGE=ghcr.io/kausalflow/alchemist:latest   # pin a version or digest for a pilot

# ---- models ------------------------------------------------------------------
# Option A: a model server in the plant network (`docker compose --profile local-llm up -d` starts Ollama).
# The model must support tool calling. Plant data never leaves the network.
ALC_LOCAL_LLM_URL=http://ollama:11434/v1
ALC_LOCAL_MODEL=qwen3:32b
ALC_PLANNING_MODEL=local:qwen3:32b
ALC_ANALYSIS_MODEL=local:qwen3:32b
ALC_REVIEWER_MODEL=local:qwen3:32b
ALC_SMALL_MODEL=local:qwen3:32b
ALC_ALLOWED_PROVIDERS=local
# ALC_LOCAL_LLM_API_KEY=                 # if your model server wants a key

# Option B: a cloud model the plant's data policy allows, e.g. Claude through the Anthropic API or Bedrock.
# ALC_PLANNING_MODEL=anthropic:claude-opus-5-5
# ALC_ANALYSIS_MODEL=anthropic:claude-sonnet-5-5
# ALC_REVIEWER_MODEL=anthropic:claude-opus-5-5
# ALC_SMALL_MODEL=anthropic:claude-haiku-5-5
# ALC_ALLOWED_PROVIDERS=anthropic
# ANTHROPIC_API_KEY=

# ---- sign-in -----------------------------------------------------------------
# dev: pick a user from config/access.yaml (a trial on one laptop only: anyone can be anyone).
ALC_AUTH=dev
# oidc: users sign in with the plant's identity provider through a sign-in proxy (see the guide).
# ALC_AUTH=oidc
# ALC_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ALC_OIDC_AUDIENCE=<client-id>
# ALC_ACCESS_PROVIDER=oidc

# ---- data sources ------------------------------------------------------------
ALC_SYNC_EVERY=15m
# PI Web API basic or bearer sign-in (Kerberos needs neither; see the guide):
# PI_WEBAPI_PASSWORD=
# PI_WEBAPI_TOKEN=

# ---- object storage ----------------------------------------------------------
# Default: run folders and the lake on the alchemist-home volume. To use the plant's object store instead (AWS S3,
# MinIO, Ceph, StorageGRID, ...), name buckets and give the S3 settings:
# ALC_WORKSPACE=s3://alchemist-workspace
# ALC_LAKE=s3://alchemist-lake
# AWS_ENDPOINT_URL=https://s3.plant.example.internal   # leave out for AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
